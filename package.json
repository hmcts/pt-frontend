{
  "name": "pt-frontend",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "NODE_ENV=production node -r module-alias/register dist/main/server.js",
    "start:dev": "nodemon --config nodemon.json",
    "lint": "stylelint **/*.scss -v -q && eslint . && prettier --check .",
    "lint:fix": "prettier --write . .github && eslint --fix",
    "build": "yarn webpack --config webpack.config.js",
    "build:prod": "NODE_ENV=production yarn webpack --mode production --config webpack.config.js",
    "build:server": "tsc",
    "test": "npx if-env CI=true && exit 0 || yarn test:unit",
    "test:unit": "jest",
    "test:coverage": "jest --coverage",
    "fortifyScan": "./src/test/java/gradlew -p src/test/java fortifyScan",
    "test:routes": "jest -c jest.routes.config.js",
    "test:a11y": "echo 'Accessibility tests implemented later in the pipeline'",
    "test:smoke": "NODE_TLS_REJECT_UNAUTHORIZED=0 jest -c jest.smoke.config.js",
    "test:functional": "NODE_CONFIG_ENV=test NODE_TLS_REJECT_UNAUTHORIZED=0 bash src/test/functional/run.sh",
    "test:functional:zephyr": "CODE=0; tsx zephyr-scripts/reset-test-outputs.ts && yarn test:functional || CODE=$?; node zephyr-scripts/run-with-log.js -- tsx zephyr-scripts/run-zephyr.ts; exit $CODE",
    "test:pact": "jest -c jest.pact.config.ts --runInBand",
    "pact:publish": "ts-node src/test/contract/publish/*.ts",
    "test:pact:run-and-publish": "yarn test:pact && yarn pact:publish",
    "test:can-i-deploy:consumer": "pact-broker can-i-deploy --pacticipant 'pt_frontend' --version $(git rev-parse --short HEAD) --broker-base-url https://pact-broker.platform.hmcts.net",
    "cichecks": "yarn install && yarn build && yarn rebuild puppeteer && yarn lint && yarn test && yarn test:routes && yarn test:a11y",
    "postinstall": "husky || true",
    "lint-staged": "lint-staged"
  },
  "_moduleAliases": {
    "@routes": "dist/main/routes",
    "@modules": "dist/main/modules",
    "@services": "dist/main/services",
    "@steps": "dist/main/steps",
    "@utils": "dist/main/utils"
  },
  "dependencies": {
    "@azure/monitor-opentelemetry": "^1.18.0",
    "@hmcts/info-provider": "^1.2.0",
    "@hmcts/nodejs-healthcheck": "1.8.6",
    "@hmcts/properties-volume": "1.4.1",
    "@ministryofjustice/frontend": "^12.0.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/otlp-transformer": "0.300.0",
    "applicationinsights": "^3.15.0",
    "axios": "1.21.0",
    "body-parser": "^2.4.0",
    "config": "4.4.1",
    "connect-redis": "8.1.0",
    "cookie-parser": "1.4.7",
    "csrf-sync": "4.2.1",
    "escape-html": "1.0.3",
    "express": "5.3.0",
    "express-session": "1.19.0",
    "form-data": "4.0.6",
    "git-rev-sync": "^3.0.2",
    "glob": "^13.0.6",
    "govuk-frontend": "6.6.0",
    "helmet": "8.3.0",
    "i18next": "26.5.11",
    "i18next-fs-backend": "2.6.9",
    "i18next-http-middleware": "3.9.11",
    "ioredis": "5.11.1",
    "jose": "6.2.13",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.11",
    "lodash": "4.18.1",
    "luxon": "3.7.2",
    "module-alias": "2.3.4",
    "moment": "^2.31.0",
    "multer": "^2.5.0",
    "node-cache": "5.1.2",
    "nunjucks": "3.2.4",
    "otpauth": "^9.5.0",
    "winston": "3.19.0",
    "xss": "^1.0.15",
    "zod": "4.6.7",
    "zod-i18n-map": "2.27.0"
  },
  "devDependencies": {
    "@codeceptjs/allure-legacy": "^1.0.2",
    "@codeceptjs/configure": "^1.0.0",
    "@eslint/compat": "2.1.1",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@eslint/plugin-kit": "0.7.3",
    "@hmcts/zephyr-automation-nodejs": "^0.0.8",
    "@jest/types": "^30.5.1",
    "@pact-foundation/pact": "^17.0.1",
    "@pact-foundation/pact-cli": "18.10.9",
    "@types/body-parser": "1.19.6",
    "@types/chai": "^5.2.1",
    "@types/config": "3.3.5",
    "@types/cookie-parser": "1.4.10",
    "@types/escape-html": "1.0.4",
    "@types/express": "5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/git-rev-sync": "^2.0.2",
    "@types/glob": "9.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9",
    "@types/lodash": "4.17.27",
    "@types/luxon": "3.7.6",
    "@types/multer": "^2.2.0",
    "@types/node": "26.6.5",
    "@types/nunjucks": "3.2.6",
    "@types/pa11y": "^5.3.7",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "chai": "4.5.0",
    "chokidar": "4.0.3",
    "codeceptjs": "^3.3.6",
    "codeceptjs-cucumber-json-reporter": "^1.0.14",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "6.11.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.17.0",
    "globals": "17.13.0",
    "html-webpack-plugin": "5.6.8",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-html-reporter": "3.10.2",
    "jest-junit": "16.0.0",
    "lint-staged": "17.6.0",
    "mini-css-extract-plugin": "2.10.2",
    "nodemon": "2.0.22",
    "pa11y": "^8.0.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.30",
    "prettier": "3.8.4",
    "sass": "1.106.1",
    "sass-loader": "13.3.3",
    "style-loader": "3.3.4",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "supertest": "^7.1.0",
    "ts-jest": "29.4.15",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "webpack": "5.112.2",
    "webpack-cli": "7.2.3",
    "webpack-dev-middleware": "8.5.0",
    "webpack-node-externals": "3.0.0"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown",
    "**/*.{js,ts}": "eslint --fix"
  },
  "resolutions": {
    "glob": "^13.0.6"
  },
  "packageManager": "yarn@4.18.1"
}
