{% from "govuk/components/button/macro.njk" import govukButton %}

{# Shared step buttons helper used by steps #}
{% macro stepButtons(primaryText, secondaryText) %}
  <div class="govuk-button-group">
    {{ govukButton({
      text: primaryText,
      attributes: { name: 'action', value: 'continue' }
    }) }}
    {% if secondaryText %}
      {{ govukButton({
        text: secondaryText,
        classes: 'govuk-button--secondary',
        attributes: { name: 'action', value: 'saveForLater' }
      }) }}
    {% endif %}
  </div>
{% endmacro %}

{# Navigation back to the landlord response case overview #}
{% macro returnToCaseOverview(caseReference) %}
  {% if caseReference %}
    {{ govukButton({
      text: 'Return to your case overview',
      href: '/' + caseReference + '/landlord-response/task-list'
    }) }}
  {% endif %}
{% endmacro %}
