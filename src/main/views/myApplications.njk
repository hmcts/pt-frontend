{% extends "stepsTemplate.njk" %}

{% from "govuk/components/tabs/macro.njk" import govukTabs %}
{% from "macros/applicationTable.njk" import applicationTable %}

{% block content %}
  <h1 class="govuk-heading-l">{{ t('myApplications') }}</h1>
  <p class="govuk-body"><a href="/start-new-application" class="govuk-link govuk-link--no-visited-state">{{ t('startNewApplicationLinkText') }}</a></p>
  {# TODO: enable link to case once WP3 work completed  #}
  {#  <p class="govuk-body"><a href="/link-to-case" class="govuk-link govuk-link--no-visited-state">{{ t('linkToCaseLinkText') }}</a></p>#}

  {% set tabItems = [] %}

  {% if applicationsAsApplicant.length > 0 %}
    {% set tabItems = (tabItems.push({
      label: "Applicant cases",
      id: "applicant-cases",
      panel: { html: applicationTable(applicationsAsApplicant) }
    }), tabItems) %}
  {% endif %}

{#  {% if applicationsAsLinkedRespondent.length > 0 %}#}
    {% set tabItems = (tabItems.push({
      label: "Respondent cases",
      id: "respondent-cases",
      panel: { html: applicationTable(applicationsAsLinkedRespondent) }
    }), tabItems) %}
{#  {% endif %}#}

  {% if tabItems.length > 0 %}
    {{ govukTabs({ items: tabItems }) }}
  {% endif %}
{% endblock %}
