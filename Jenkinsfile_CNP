#!groovy

@Library("Infrastructure@2.4.8")

import uk.gov.hmcts.contino.AppPipelineDsl
import uk.gov.hmcts.contino.GithubAPI

def type = "nodejs"
def product = "pt"
def component = "frontend"

// Script binding, not a local: methods below (uploadFunctionalResultsToZephyr) cannot see `def` variables
yarnBuilder = new uk.gov.hmcts.contino.YarnBuilder(this)

static Map < String, Object > secret(String secretName, String envVariable) {
  [
    $class: 'AzureKeyVaultSecret',
    secretType: 'Secret',
    name: secretName,
    envVariable: envVariable
  ]
}

def secrets = [
  'pt-kv-${env}': [
    secret('pt-frontend-idam-secret', 'PT_FRONTEND_IDAM_SECRET'),
    secret('pt-idam-test-user-password', 'IDAM_PT_USER_PASSWORD'),
    secret('pt-api-idam-secret', 'PT_API_IDAM_SECRET'),
    secret('JIRA-AUTH-TOKEN', 'JIRA_AUTH_TOKEN'),
  ]
]

def configureFunctionalTestEnv(String testUrl) {
  env.NODE_TLS_REJECT_UNAUTHORIZED = '0'
  env.TEST_URL = testUrl
}

def uploadFunctionalResultsToZephyr(String environmentName) {
  if (!steps.fileExists('functional-output/zephyr/cucumber-report.json')) {
    steps.echo 'No cucumber report found, skipping Zephyr upload'
    return
  }
  env.EXECUTION_BUILD = env.GIT_COMMIT
  env.EXECUTION_ENVIRONMENT = environmentName
  env.EXECUTION_TEST_CYCLE_DESCRIPTION =
    "pt-frontend ${environmentName} build ${env.BUILD_NUMBER} for commit ${env.GIT_COMMIT}\n${env.BUILD_URL}"
  yarnBuilder.yarn('node zephyr-scripts/run-with-log.js -- tsx zephyr-scripts/run-zephyr.ts')
}

def archiveFunctionalAndZephyrOutputs() {
  steps.archiveArtifacts allowEmptyArchive: true, artifacts: 'functional-output/**,tmp/zephyr/**'
}

/** First PR label matching prefix → value after prefix (e.g. e2e-tag:@smoke → @smoke) */
def prLabelSuffix(githubApi, String prefix) {
  def labels = githubApi.getLabelsbyPattern(env.BRANCH_NAME, prefix)
  return (labels && labels.size() > 0) ? labels[0].replaceFirst('^' + prefix, '') : null
}

withPipeline(type, product, component) {
  def githubApi = new GithubAPI(this)
  loadVaultSecrets(secrets)
  env.NODE_CONFIG_ENV = 'test'
  env.PT_API_URL = "http://pt-api-aat.service.core-compute-aat.internal"
  env.DATA_STORE_URL_BASE = "http://ccd-data-store-api-aat.service.core-compute-aat.internal"
  env.CDAM_URL = "http://ccd-case-document-am-api-aat.service.core-compute-aat.internal"
  env.XUI_BASE_URI = "https://manage-case.aat.platform.hmcts.net"
  env.CASE_TYPE_ID = "PT"
  onPR() {
    env.E2E_TEST_SCOPE = '@sanity'
    if (githubApi.getLabelsbyPattern(env.BRANCH_NAME, "enable_critical_test").size() > 0) {
      env.E2E_TEST_SCOPE = '@PR'
    }
    def e2eTag = prLabelSuffix(githubApi, 'e2e-tag:')
    if (e2eTag?.trim()) {
      env.E2E_TEST_SCOPE = e2eTag.trim()
    }

    def e2eSpec = prLabelSuffix(githubApi, 'e2e-spec:')
    if (e2eSpec?.trim()) {
      env.E2E_SPEC = e2eSpec.trim()
    }

    env.TEST_URL = "https://pt-frontend-pr-${env.CHANGE_ID}.preview.platform.hmcts.net/"

    def apiLabels = githubApi.getLabelsbyPattern(env.BRANCH_NAME, "pt-api-pr:")
    if (apiLabels && apiLabels.size() > 0) {
      def labelName = apiLabels[0]
      env.PT_API_CHANGE_ID = labelName.replace("pt-api-pr:", "")
      env.DATA_STORE_URL_BASE = "https://ccd-data-store-api-pct-api-pr-${env.PT_API_CHANGE_ID}.preview.platform.hmcts.net"
      env.PT_API_URL = "https://pt-api-pr-${env.PT_API_CHANGE_ID}.preview.platform.hmcts.net"
      env.CDAM_URL = "http://pt-api-pr-${env.PT_API_CHANGE_ID}-cdam"
      env.XUI_BASE_URI = "https://xui-pt-api-pr-${env.PT_API_CHANGE_ID}.preview.platform.hmcts.net"
      env.CASE_API_URL = "https://pt-api-pr-${env.PT_API_CHANGE_ID}.preview.platform.hmcts.net"
    }
    enablePactAs([
      AppPipelineDsl.PactRoles.CONSUMER,
      AppPipelineDsl.PactRoles.CONSUMER_DEPLOY_CHECK
    ])

    before('functionalTest:preview') {
      configureFunctionalTestEnv(env.TEST_URL)
      sh 'rm -rf functional-output tmp/zephyr'
    }

    afterAlways('functionalTest:preview') {
      archiveFunctionalAndZephyrOutputs()
    }
  }

  onMaster() {
    env.E2E_TEST_SCOPE = '@regression'
    env.TEST_URL = "https://pt.aat.platform.hmcts.net/"
    enablePactAs([
      AppPipelineDsl.PactRoles.CONSUMER,
      AppPipelineDsl.PactRoles.CONSUMER_DEPLOY_CHECK
    ])

    before('functionalTest:aat') {
      configureFunctionalTestEnv(env.TEST_URL)
      sh 'rm -rf functional-output tmp/zephyr'
    }

    // Upload pass and fail results alike, so Zephyr reflects the real state of the suite
    afterAlways('functionalTest:aat') {
      try {
        uploadFunctionalResultsToZephyr('aat')
      } finally {
        archiveFunctionalAndZephyrOutputs()
      }
    }
  }
}
