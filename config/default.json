{
  "port": 4000,
  "useCSRFProtection": true,
  "appInsights": {
    "connectionString": false
  },
  "security": {
    "referrerPolicy": "same-origin",
    "hsts": {
      "maxAge": 31536000,
      "includeSubDomains": true,
      "preload": true
    }
  },
  "http": {
    "timeoutMs": 30000
  },
  "api": {
    "url": "http://pt-api-aat.service.core-compute-aat.internal"
  },
  "ccd": {
    "url": "http://ccd-data-store-api-aat.service.core-compute-aat.internal",
    "caseTypeId": "PT"
  },
  "cdam": {
    "url": "http://ccd-case-document-am-api-aat.service.core-compute-aat.internal"
  },
  "equalityAndDiversity": {
    "name": "Equality and Diversity Service",
    "url": "http://localhost:5000",
    "path": "/service-endpoint",
    "port": 5000,
    "tokenKey": "SERVICE_TOKEN_KEY"
  },
  "documentUpload": {
    "maxFileSizeMB": 25,
    "maxTotalFileSizeMB": 300,
    "maxFilenameLength": 255,
    "timeoutMs": 300000,
    "maxFilesPerUpload": 3
  },
  "idam": {
    "authorizationURL": "https://hmcts-access.aat.platform.hmcts.net/o/authorize",
    "tokenURL": "https://hmcts-access.aat.platform.hmcts.net/o/token",
    "endSessionURL": "https://hmcts-access.aat.platform.hmcts.net/o/endSession",
    "clientID": "pt-frontend",
    "authorizationScope": "openid profile roles",
    "clientSecret": "NEED TO INSERT SECRET",
    "systemUsername": "dummy_user",
    "systemPassword": "NEED TO INSERT SECRET",
    "caching": false,
    "requiredRole": "citizen"
  },
  "oidc": {
    "accessTokenEarlyRefreshSeconds": 30
  },
  "authProvider": {
    "url": "http://rpe-service-auth-provider-aat.service.core-compute-aat.internal",
    "microservice": "pt_frontend",
    "secret": "NEED TO INSERT SECRET"
  },
  "session": {
    "redis-connection-string": "redis://localhost:6379",
    "pt-session-secret": "NEED TO INSERT SECRET",
    "prefix": "pt-session",
    "cookieName": "pt_session",
    "redis": {
      "ttlInSeconds": 5400
    },
    "timeout": {
      "sessionWarningMinutes": 10,
      "sessionTimeoutMinutes": 60,
      "checkIntervalSeconds": 10
    }
  }
}
